@supabase_url = https://mlacfhjxzjrwcyxyvpym.supabase.co
@supabase_publishable_key = sb_secret_08si9Jc_ejf9d8Fjff3z_A_9XArqxhr


### ============================================
### PASO 0 — Login: obtener el access_token de tus 2 usuarios de prueba
### Corre esto una vez por usuario y pega cada access_token abajo.
### Los tokens duran ~1h — si empiezan a fallar con 401 sin razón,
### vuelve a correr el login del usuario correspondiente.
### ============================================

POST {{supabase_url}}/auth/v1/token?grant_type=password
apikey: {{supabase_publishable_key}}
Content-Type: application/json

{
    "email": "alumno@apuntesu.dev",
    "password": "Demo1234!"
}

###

POST {{supabase_url}}/auth/v1/token?grant_type=password
apikey: {{supabase_publishable_key}}
Content-Type: application/json

{
    "email": "monitor@apuntesu.dev",
    "password": "Demo1234!"
}


